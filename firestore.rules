rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // This admin app stores its data in one document. Only users created in
    // Firebase Authentication may read or change it.
    match /kerlipApp/mainData {
      allow read, write: if request.auth != null;
    }

    // Deny every other collection by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
